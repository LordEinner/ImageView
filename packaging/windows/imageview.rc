// Windows resources: application icon (shown in Explorer and the taskbar) and
// version info. imageview.ico is generated from src/icon.svg at build time by
// make_ico (see CMakeLists.txt) into the build directory.
#include <winver.h>

1 ICON "imageview.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ImageView"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ImageView"
            VALUE "OriginalFilename", "ImageView.exe"
            VALUE "ProductName", "ImageView"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
